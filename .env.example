# ================================================================
# Stratum AI - Environment Configuration Template
# ================================================================

# Application
APP_NAME=Stratum AI
APP_ENV=development            # development | production (production refuses to start with weak/missing secrets)
DEBUG=False
PORT=8000
HOST=0.0.0.0
# --- Security (REQUIRED in production) ---------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Shared secret lead sources must send as the X-Webhook-Secret header on /api/leads/webhook
WEBHOOK_SECRET=
# Bootstrap admin created on first start. Leave ADMIN_PASSWORD empty to get a random one printed once in the log.
ADMIN_EMAIL=admin@stratum.ai
ADMIN_PASSWORD=
# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Reject Twilio webhooks without a valid X-Twilio-Signature (disable only for local tests)
ENFORCE_TWILIO_SIGNATURES=True

# Database (Default: SQLite for zero-config local run; or use PostgreSQL)
DATABASE_URL=sqlite:///./stratum.db
# DATABASE_URL=postgresql://user:password@localhost:5432/stratum

# AI Provider Selection
DEFAULT_LLM_PROVIDER=mock      # Options: groq, openai, mock
DEFAULT_STT_PROVIDER=mock      # Options: sarvam, deepgram, mock
DEFAULT_TTS_PROVIDER=edge_tts  # Options: edge_tts, sarvam, elevenlabs, mock

# LLM Providers
GROQ_API_KEY=                  # Recommended for ultra-low latency voice (Llama 3.3 70B)
OPENAI_API_KEY=                # GPT-4o / GPT-4o-mini

# Speech-to-Text Providers
SARVAM_API_KEY=                # Indian language specialist STT (Saarika v2)
DEEPGRAM_API_KEY=              # Nova-2 multilingual streaming STT

# Text-to-Speech Providers
# (Edge-TTS uses Microsoft Neural Indian voices for Telugu, Hindi, English, Tamil with NO API key required!)
ELEVENLABS_API_KEY=

# Telephony Gateway Configuration
TELEPHONY_PROVIDER=web_simulator # Options: web_simulator, twilio, exotel

# Twilio Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_WEBHOOK_URL=            # e.g., https://your-domain.ngrok-free.app/api/telephony/twilio/webhook
PUBLIC_BASE_URL=               # e.g., your-domain.ngrok-free.app

# Exotel India Credentials (Optional - TRAI Compliant)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# Telecom & Business Compliance
CALLING_HOURS_START=9          # 9:00 AM IST
CALLING_HOURS_END=20           # 8:00 PM IST
MAX_CALL_RETRIES=3
CONSENT_DISCLOSURE_ENABLED=True
